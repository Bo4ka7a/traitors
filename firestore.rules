rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(uid));
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/seasons/{season} {
      allow read, delete: if allowed(uid);
      allow create, update: if allowed(uid)
        && request.resource.data.keys().hasOnly(['id','payload'])
        && request.resource.data.id == season
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 720000;
    }
  }
}
